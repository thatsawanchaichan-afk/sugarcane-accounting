{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:config": "node scripts/check-config.mjs",
    "db:create": "npx --yes wrangler@4 d1 create sugarcane-ledger",
    "db:migrate": "node scripts/check-config.mjs && npx --yes wrangler@4 d1 migrations apply sugarcane-ledger --remote",
    "deploy": "node scripts/check-config.mjs && npx --yes wrangler@4 deploy",
    "dev": "npx --yes wrangler@4 dev"
  }
}
